{
  "name": "pi-gimme",
  "version": "0.1.2",
  "description": "Extract structured data from a pi session",
  "type": "module",
  "license": "MIT",
  "author": "Tanner Hobson",
  "keywords": [
    "pi-package",
    "pi",
    "structured-data",
    "tools",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/player1537/pi-gimme"
  },
  "bugs": {
    "url": "https://github.com/player1537/pi-gimme/issues"
  },
  "homepage": "https://github.com/player1537/pi-gimme#readme",
  "files": [
    "extensions/",
    "lib/",
    "docs/",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/parser.test.mjs tests/schema.test.mjs tests/validate.test.mjs tests/flags.test.mjs tests/extension.test.mjs",
    "ci": "npm run typecheck && npm test && npm run smoke:pi && npm run pack:check",
    "smoke:pi": "node scripts/pi-sdk-smoke.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "overrides": {
    "protobufjs": ">=7.6.3 <8.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^26.6.4",
    "typebox": "latest",
    "typescript": "^7.0.2"
  }
}
